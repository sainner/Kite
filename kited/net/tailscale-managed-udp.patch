 // reduce flap events.
+// managedUDP and managedUDP6 are set when all UDP goes through an injected
+// PacketListener, such as an authenticated tunnel (Kite patch).
+var managedUDP, managedUDP6 atomic.Bool
+
+// SetManagedUDP declares that every UDP packet netcheck sends via SendPacket
+// leaves through an injected PacketListener rather than the host network, and
+// whether that path carries IPv6. IPv6 STUN is then probed even when the host
+// interfaces have no IPv6, and the ICMP fallback, which would use the host
+// network, is skipped (Kite patch).
+func SetManagedUDP(ipv6 bool) {
+	managedUDP.Store(true)
+	managedUDP6.Store(ipv6)
+}
