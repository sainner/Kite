 // c.mu must NOT be held.
+// localEndpointFilter, if set, decides which local interface addresses are
+// advertised as endpoints (Kite patch).
+var localEndpointFilter atomic.Pointer[func(netip.Addr) bool]
+
+// SetLocalEndpointFilter limits the local interface addresses advertised as
+// endpoints to those for which keep returns true, e.g. when UDP goes through an
+// injected PacketListener and only some host addresses are actually reachable
+// (Kite patch).
+func SetLocalEndpointFilter(keep func(netip.Addr) bool) {
+	localEndpointFilter.Store(&keep)
+}
+
+// ForgetCachedEndpoints drops endpoints remembered from earlier netchecks, so
+// the next ReSTUN advertises only what it discovers. Call it when the network
+// changed and old mappings are known to be stale (Kite patch).
+func (c *Conn) ForgetCachedEndpoints() {
+	c.endpointTracker.mu.Lock()
+	defer c.endpointTracker.mu.Unlock()
+	c.endpointTracker.endpoints = nil
+}
